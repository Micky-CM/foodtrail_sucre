# Configuración de APIs de LLM
# Copia este archivo a .env en la raíz del proyecto y agrega tus API keys

# Groq API (Gratuito - Recomendado)
# Obtén tu API key gratis en: https://console.groq.com/
GROQ_API_KEY=tu_groq_api_key_aqui

# OpenAI API (De pago)
# Obtén tu API key en: https://platform.openai.com/
OPENAI_API_KEY=tu_openai_api_key_aqui

# Configuración del proveedor de LLM
# Opciones: "groq", "openai", "fallback"
LLM_PROVIDER=groq
